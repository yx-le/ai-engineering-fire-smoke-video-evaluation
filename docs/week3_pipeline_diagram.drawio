<mxfile host="app.diagrams.net" modified="2026-11-11T11:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="week3-pipeline-v1" name="Week 3 Pipeline V1"><mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="source" value="&lt;b&gt;SOURCE&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;evo_10.mp4 + evo_11.mp4&lt;br/&gt;video-ground-truths.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#334155;fontColor=#0f172a;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="250" height="140" as="geometry" /></mxCell><mxCell id="ingest" value="&lt;b&gt;INGEST&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Resolve selected files&lt;br/&gt;Check presence + SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#334155;fontColor=#0f172a;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="345" y="190" width="250" height="140" as="geometry" /></mxCell><mxCell id="inspect" value="&lt;b&gt;INSPECT&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Read video metadata&lt;br/&gt;Check label schema + coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#334155;fontColor=#0f172a;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="250" height="140" as="geometry" /></mxCell><mxCell id="prepare" value="&lt;b&gt;PREPARE / TRANSFORM&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Sample every 2 s&lt;br/&gt;Resize ≤640 px; JPEG q90" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#334155;fontColor=#0f172a;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="955" y="190" width="250" height="140" as="geometry" /></mxCell><mxCell id="validate" value="&lt;b&gt;VALIDATE OUTPUT&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Decode samples + inspect ZIPs&lt;br/&gt;Check non-empty outputs + hashes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;fontColor=#0f172a;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1260" y="190" width="250" height="140" as="geometry" /></mxCell><mxCell id="lineage" value="&lt;b&gt;RECORD LINEAGE&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Write pipeline_manifest.json&lt;br/&gt;Record hashes + mappings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#334155;fontColor=#0f172a;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1565" y="190" width="250" height="140" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" parent="1" source="source" target="ingest"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" parent="1" source="ingest" target="inspect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" parent="1" source="inspect" target="prepare"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" parent="1" source="prepare" target="validate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" parent="1" source="validate" target="lineage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fail_input" value="&lt;b&gt;FAILURE POINT 1 — INGEST&lt;/b&gt;&lt;br/&gt;Missing, unreadable, or out-of-root source&lt;br/&gt;&lt;br/&gt;Response: stop before inspection; report the exact missing/invalid path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="130" y="520" width="650" height="150" as="geometry" /></mxCell><mxCell id="fail_output" value="&lt;b&gt;FAILURE POINT 2 — VALIDATE OUTPUT&lt;/b&gt;&lt;br/&gt;Empty, undecodable, or hash-mismatched output&lt;br/&gt;&lt;br/&gt;Response: fail the run; do not register success; rerun after correcting the cause." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="980" y="520" width="650" height="150" as="geometry" /></mxCell><mxCell id="ef1" value="error path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#b91c1c;strokeWidth=2;" edge="1" parent="1" source="ingest" target="fail_input"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ef2" value="error path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#b91c1c;strokeWidth=2;" edge="1" parent="1" source="validate" target="fail_output"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>