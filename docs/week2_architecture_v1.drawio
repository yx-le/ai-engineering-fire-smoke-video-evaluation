          <mxGeometry x="1285" y="265" width="245" height="240" as="geometry" />
        </mxCell>
        <mxCell id="metrics" value="&lt;b&gt;Temporal Matcher&lt;br/&gt;&amp; Metrics&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Compare predictions to labels&lt;br/&gt;Frame + event measures&lt;br/&gt;Separate false alarms and misses&lt;br/&gt;Calculate delay when supported&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#526579&quot; style=&quot;font-size:12px&quot;&gt;FR-03 · NFR-01 · RAI-02/03&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0E7FC;strokeColor=#8053B8;strokeWidth=2;fontSize=15;fontColor=#1B2B3A;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
