        <mxCell id="gate" value="&lt;b&gt;Scope &amp; Manifest Gate&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Validate IDs, source/access,&lt;br/&gt;labels, and annotations&lt;br/&gt;Accept permitted clips only&lt;br/&gt;Reject incomplete or live inputs&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#526579&quot; style=&quot;font-size:12px&quot;&gt;FR-01 · RAI-05&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#D88A1D;strokeWidth=2;fontSize=15;fontColor=#1B2B3A;align=center;verticalAlign=middle;spacing=12;dashed=1;dashPattern=8 5;" vertex="1" parent="1">
