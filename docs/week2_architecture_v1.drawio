        </mxCell>
        <mxCell id="sampler" value="&lt;b&gt;Offline Clip Sampler&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Read approved clips&lt;br/&gt;one at a time&lt;br/&gt;Send sampled frames with&lt;br/&gt;timestamps to detection&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#526579&quot; style=&quot;font-size:12px&quot;&gt;FR-02 · NFR-04&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#7186A2;strokeWidth=2;fontSize=15;fontColor=#1B2B3A;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
